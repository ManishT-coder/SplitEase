# ==================
# MongoDB
# Local: mongodb://localhost:27017/splitease
# Atlas: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/splitease?retryWrites=true&w=majority
# ==================
MONGODB_URI=mongodb://localhost:27017/splitease

# ==================
# Authentication
# ==================
JWT_SECRET=your-super-long-random-secret-key
JWT_EXPIRE=7d

# ==================
# Server
# ==================
PORT=5000
NODE_ENV=development

# ==================
# CORS
# ==================
CLIENT_URL=http://localhost:3000

# ==================
# Email (Optional)
# ==================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password